# ==========================================
# Frontend Configuration (Vite + TypeScript)
# ==========================================
# Supabase project URL (e.g. https://xyzcompany.supabase.co or http://127.0.0.1:54321 for local development)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase public anonymous API key (safe for client-side exposure)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Application meta
VITE_APP_NAME=VibeMapping
VITE_APP_ENV=development

# Optional Backend / Mock API URL
VITE_API_BASE_URL=http://localhost:3000/api

# ==========================================
# Supabase Backend & Database Configuration
# ==========================================
# Supabase Project Reference (from project settings in cloud dashboard)
SUPABASE_PROJECT_ID=your_project_ref

# Service Role Key (NEVER expose to frontend; only for Edge Functions, Seed scripts, or Server tasks)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database connection credentials for local migrations or direct pg connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# Direct database connection URL (for migration tools or scripts)
DATABASE_URL=postgresql://postgres:your_postgres_password@127.0.0.1:54322/postgres
